{
  "name": "personal-color",
  "private": true,
  "version": "0.0.0",
  "description": "personal-color monorepo (web + core + design tokens)",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "tokens": "npm run build -w packages/design-tokens",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:photos": "node scripts/check-no-photos.mjs",
    "check": "npm run check:secrets && npm run check:photos && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
