# 이 파일은 "이름만" 적는 예시입니다. 실제 값은 .env.local 에 넣고 절대 커밋하지 마세요. (S-1)
# 공개 가능한 값 (브라우저에 노출돼도 되는 것만) — 접두사 NEXT_PUBLIC_
NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 값은 이 저장소 파일이 아니라 Supabase 서버 설정(시크릿)에만 둡니다. (M6/M8에서 추가)
# 예: ANTHROPIC_API_KEY, SUPABASE_SERVICE_ROLE_KEY  ← 여기에 값을 쓰지 마세요
